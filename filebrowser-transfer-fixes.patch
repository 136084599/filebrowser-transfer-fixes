@@ -0,0 +1,57 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+vi.mock("@/store", () => ({ state: { sessionId: "preview-session" } }));
+vi.mock("@/utils/auth", () => ({ renew: vi.fn(async () => {}) }));
+import { renew } from "@/utils/auth";
+import { fetchPreviewImage } from "./previewRequests";
+
+const reply = (status = 200, content = "image data") => ({ ok: status === 200, status, body: { cancel: vi.fn() }, blob: async () => new Blob([content], { type: "image/jpeg" }) });
+beforeEach(() => { vi.useFakeTimers(); vi.clearAllMocks(); vi.stubGlobal("fetch", vi.fn()); vi.spyOn(URL, "createObjectURL").mockReturnValue("blob:preview"); });
+afterEach(() => { vi.useRealTimers(); vi.restoreAllMocks(); vi.unstubAllGlobals(); });
+
+describe("preview recovery", () => {
+  it("retries a temporary failure and bypasses the failed HTTP cache", async () => {
+    fetch.mockResolvedValueOnce(reply(503)).mockResolvedValueOnce(reply());
+    const pending = fetchPreviewImage("/api/resources/preview", new AbortController().signal);
+    await vi.runAllTimersAsync();
+    expect(await pending).toBe("blob:preview");
+    expect(fetch).toHaveBeenCalledTimes(2);
+    expect(fetch.mock.calls[1][1].cache).toBe("reload");
+  });
+  it("renews a protected session once without bypassing permissions", async () => {
+    fetch.mockResolvedValueOnce(reply(401)).mockResolvedValueOnce(reply());
+    expect(await fetchPreviewImage("/api/resources/preview")).toBe("blob:preview");
+    expect(renew).toHaveBeenCalledTimes(1);
+  });
+  it.each([403, 404])("does not retry permanent HTTP %s errors", async status => {
+    fetch.mockResolvedValue(reply(status));
+    await expect(fetchPreviewImage("/api/resources/preview")).rejects.toMatchObject({ status });
+    expect(fetch).toHaveBeenCalledTimes(1);
+  });
+  it("caps active requests and removes cancelled queued requests", async () => {
+    const responses = [];
+    fetch.mockImplementation(() => new Promise(resolve => responses.push(resolve)));
+    const controllers = Array.from({ length: 6 }, () => new AbortController());
+    const pending = controllers.map(c => fetchPreviewImage("/api/resources/preview", c.signal));
+    const cancelled = expect(pending[5]).rejects.toMatchObject({ name: "AbortError" });
+    await vi.advanceTimersByTimeAsync(0);
+    expect(fetch).toHaveBeenCalledTimes(4);
+    controllers[5].abort();
+    await cancelled;
+    for (const respond of responses.slice()) respond(reply());
+    await vi.advanceTimersByTimeAsync(0);
+    expect(fetch).toHaveBeenCalledTimes(5);
+    responses[4](reply());
+    await Promise.all(pending.slice(0, 5));
+  });
+  it("cancels retry backoff immediately when leaving the folder", async () => {
+    fetch.mockResolvedValue(reply(503));
+    const controller = new AbortController();
+    const pending = fetchPreviewImage("/api/resources/preview", controller.signal);
+    const rejected = expect(pending).rejects.toMatchObject({ name: "AbortError" });
+    await vi.advanceTimersByTimeAsync(0);
+    controller.abort();
+    await rejected;
+    await vi.runAllTimersAsync();
+    expect(fetch).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/frontend/src/utils/promptStack.js b/frontend/src/utils/promptStack.js
new file mode 100644
index 0000000000000000000000000000000000000000..4ce4da0fdf91fb46b2192fa5fe260b9af2597ed6
--- /dev/null
+++ b/frontend/src/utils/promptStack.js
@@ -0,0 +1,56 @@
+export function isPromptDescendant(prompts, id, ancestorId) {
+  const seen = new Set();
+  let prompt = prompts.find(entry => entry.id === id);
+  while (typeof prompt?.parentId === 'number' && !seen.has(prompt.id)) {
+    seen.add(prompt.id);
+    if (prompt.parentId === ancestorId) return true;
+    prompt = prompts.find(entry => entry.id === prompt.parentId);
+  }
+  return false;
+}
+
+export function promptRootId(prompts, id) {
+  const seen = new Set();
+  let prompt = prompts.find(entry => entry.id === id);
+  while (typeof prompt?.parentId === 'number' && !seen.has(prompt.id)) {
+    seen.add(prompt.id);
+    const parent = prompts.find(entry => entry.id === prompt.parentId);
+    if (!parent) break;
+    prompt = parent;
+  }
+  return prompt?.id ?? id;
+}
+
+export function isPromptBlocked(prompts, prompt) {
+  if (!prompt) return true;
+  if (prompts.some(entry => entry.parentId === prompt.id)) return true;
+  const pinned = [...prompts].reverse().find(entry => entry.pinned);
+  return !!(pinned && pinned.id !== prompt.id && !isPromptDescendant(prompts, prompt.id, pinned.id));
+}
+
+export function insertPrompt(prompts, entry) {
+  if (typeof entry.parentId === 'number' && prompts.some(prompt => prompt.id === entry.parentId)) {
+    let index = prompts.findIndex(prompt => prompt.id === entry.parentId) + 1;
+    while (index < prompts.length && isPromptDescendant(prompts, prompts.at(index)?.id, entry.parentId)) index++;
+    return [...prompts.slice(0, index), entry, ...prompts.slice(index)];
+  }
+  const pinned = prompts.find(prompt => prompt.pinned);
+  if (entry.pinned || !pinned) return [...prompts, entry];
+  const index = prompts.findIndex(prompt => prompt.id === promptRootId(prompts, pinned.id));
+  return [...prompts.slice(0, index), entry, ...prompts.slice(index)];
+}
+
+export function raisePrompt(prompts, id) {
+  const prompt = prompts.find(entry => entry.id === id);
+  if (!prompt || isPromptBlocked(prompts, prompt) || prompts.at(-1)?.id === id) return prompts;
+  const rootId = promptRootId(prompts, id);
+  const group = prompts.filter(entry => entry.id === rootId || isPromptDescendant(prompts, entry.id, rootId));
+  const rest = prompts.filter(entry => !group.includes(entry));
+  const pinned = rest.find(entry => entry.pinned);
+  const index = pinned ? rest.findIndex(entry => entry.id === promptRootId(rest, pinned.id)) : rest.length;
+  return [...rest.slice(0, index), ...group, ...rest.slice(index)];
+}
+
+export function withoutPromptTree(prompts, id) {
+  return prompts.filter(entry => entry.id !== id && !isPromptDescendant(prompts, entry.id, id));
+}
diff --git a/frontend/src/utils/promptStack.test.js b/frontend/src/utils/promptStack.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..87f2ad4716f2e500c2bbaa427705d03c3583b99a
--- /dev/null
+++ b/frontend/src/utils/promptStack.test.js
@@ -0,0 +1,46 @@
+import { describe, expect, it } from 'vitest';
+import { insertPrompt, isPromptBlocked, isPromptDescendant, raisePrompt, withoutPromptTree } from './promptStack';
+
+describe('modal parent and child ordering', () => {
+  it('keeps an unpinned child above a pinned parent and accepts its input', () => {
+    const parent = { id: 1, pinned: true };
+    const child = { id: 2, parentId: 1 };
+    const stack = insertPrompt([parent], child);
+    expect(stack).toEqual([parent, child]);
+    expect(isPromptBlocked(stack, parent)).toBe(true);
+    expect(isPromptBlocked(stack, child)).toBe(false);
+  });
+  it('keeps the deepest child interactive through nested pinned dialogs', () => {
+    const stack = [{ id: 1 }, { id: 2, parentId: 1, pinned: true }, { id: 3, parentId: 2 }];
+    expect(stack.map(prompt => isPromptBlocked(stack, prompt))).toEqual([true, true, false]);
+  });
+  it('inserts independent background windows below the entire pinned family', () => {
+    const stack = [{ id: 1 }, { id: 2, pinned: true, parentId: 1 }];
+    expect(insertPrompt(stack, { id: 3, parentId: null }).map(prompt => prompt.id)).toEqual([3, 1, 2]);
+  });
+  it('inserts a background child below an unrelated pinned family', () => {
+    const stack = [{ id: 1 }, { id: 2, pinned: true, parentId: null }];
+    const result = insertPrompt(stack, { id: 3, parentId: 1 });
+    expect(result.map(prompt => prompt.id)).toEqual([1, 3, 2]);
+    expect(isPromptBlocked(result, result[1])).toBe(true);
+    expect(isPromptBlocked(result, result[2])).toBe(false);
+  });
+  it('does not mutate or reorder the top dialog during mousedown', () => {
+    const stack = [{ id: 1 }, { id: 2, parentId: 1 }];
+    expect(raisePrompt(stack, 2)).toBe(stack);
+  });
+  it('raises a window family together without putting a parent over its child', () => {
+    const stack = [{ id: 1 }, { id: 2, parentId: 1 }, { id: 3, parentId: null }];
+    expect(raisePrompt(stack, 2).map(prompt => prompt.id)).toEqual([3, 1, 2]);
+    expect(raisePrompt(stack, 1)).toBe(stack);
+  });
+  it('closing an owner removes all descendants but preserves unrelated windows', () => {
+    const stack = [{ id: 1 }, { id: 2, parentId: 1, pinned: true }, { id: 3, parentId: 2 }, { id: 4, parentId: null }];
+    expect(withoutPromptTree(stack, 1)).toEqual([{ id: 4, parentId: null }]);
+    expect(withoutPromptTree(stack, 2)).toEqual([{ id: 1 }, { id: 4, parentId: null }]);
+  });
+  it('handles stale and cyclic parents without looping', () => {
+    expect(isPromptDescendant([{ id: 1, parentId: 2 }, { id: 2, parentId: 1 }], 1, 99)).toBe(false);
+    expect(isPromptBlocked([], null)).toBe(true);
+  });
+});
