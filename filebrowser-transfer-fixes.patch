+
+func TestEmptyOrTruncatedPreviewCacheRegenerates(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "fixture.png")
+	f, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	img := image.NewRGBA(image.Rect(0, 0, 240, 120))
+	for y := 0; y < 120; y++ {
+		for x := 0; x < 240; x++ {
+			img.Set(x, y, color.RGBA{R: uint8(x), G: uint8(y), B: uint8(x + y), A: 255})
+		}
+	}
+	png.Encode(f, img)
+	f.Close()
+	stat, _ := os.Stat(path)
+	previous := service
+	service = NewPreviewGenerator(1, dir)
+	defer func() { service = previous }()
+	file := iteminfo.ExtendedFileInfo{RealPath: path, FileInfo: iteminfo.FileInfo{ItemInfo: iteminfo.ItemInfo{Name: "fixture.png", Type: "image/png", Size: stat.Size(), ModTime: stat.ModTime(), HasPreview: true}}}
+	sum := md5.Sum([]byte(fmt.Sprintf("%s:%d:%s", path, stat.Size(), stat.ModTime().Format(time.RFC3339Nano))))
+	key := CacheKey(hex.EncodeToString(sum[:]), "small", 0)
+	for _, bad := range [][]byte{nil, []byte("truncated")} {
+		service.fileCache.Store(context.Background(), key, bad)
+		result, err := GetPreviewForFile(context.Background(), file, "small", "", 0)
+		if err != nil || len(result) < minPreviewSize {
+			t.Fatal("preview stayed poisoned", len(result), err)
+		}
+	}
+}
diff --git a/backend/internal/preview/flights.go b/backend/internal/preview/flights.go
new file mode 100644
index 0000000000000000000000000000000000000000..2c40c864abd618880f84e4e11b639445ed01345d
--- /dev/null
+++ b/backend/internal/preview/flights.go
@@ -0,0 +1,75 @@
+package preview
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+)
+
+type previewFlight struct {
+	done   chan struct{}
+	cancel context.CancelFunc
+	refs   int
+	data   []byte
+	err    error
+}
+
+type previewFlights struct {
+	sync.Mutex
+	jobs map[string]*previewFlight
+}
+
+// Share a cache miss while keeping each caller's cancellation independent.
+// Work stops when the last viewer leaves, or after the normal preview deadline.
+func (g *previewFlights) do(ctx context.Context, key string, generate func(context.Context) ([]byte, error)) ([]byte, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	g.Lock()
+	if g.jobs == nil {
+		g.jobs = make(map[string]*previewFlight)
+	}
+	job := g.jobs[key]
+	if job == nil {
+		work, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+		job = &previewFlight{done: make(chan struct{}), cancel: cancel}
+		g.jobs[key] = job
+		go func(j *previewFlight) {
+			defer cancel()
+			func() {
+				defer func() {
+					if value := recover(); value != nil {
+						j.err = fmt.Errorf("preview generation failed: %v", value)
+					}
+				}()
+				j.data, j.err = generate(work)
+			}()
+			g.Lock()
+			if g.jobs[key] == j {
+				delete(g.jobs, key)
+			}
+			close(j.done)
+			g.Unlock()
+		}(job)
+	}
+	job.refs++
+	g.Unlock()
+	defer func() {
+		g.Lock()
+		job.refs--
+		if job.refs == 0 {
+			if g.jobs[key] == job {
+				delete(g.jobs, key)
+			}
+			job.cancel()
+		}
+		g.Unlock()
+	}()
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-job.done:
+		return job.data, job.err
+	}
+}
